{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"endOfLine": "lf",
	"printWidth": 100,
	"proseWrap": "always",
	"semi": true,
	"singleQuote": false,
	"tabWidth": 2,
	"trailingComma": "all",
	"useTabs": true,
	"sortPackageJson": false,
	"astro": {},
	"sortImports": {
		"groups": [
			"side_effect",
			"builtin",
			"external",
			["internal", "subpath"],
			["parent", "sibling", "index"],
			"style",
			"unknown"
		],
		"internalPattern": ["@/", "~/"]
	},
	"sortTailwindcss": {
		"stylesheet": "./src/styles/tailwind.css",
		"attributes": ["class:list"],
		"functions": ["cn", "styles"]
	},
	"ignorePatterns": ["content/**", "public/**", "pnpm-lock.yaml"]
}
