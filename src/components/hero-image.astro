---
import { Image } from "astro:assets";

import { getContentImage } from "@/lib/content/get-content-image";

interface Props {
	src: string;
}

const { src } = Astro.props;
const source = await getContentImage(src);
const maxWidth = Math.min(source?.width ?? 2560, 2560);
const widths = [480, 768, 1024, 1440, 1920].filter((width) => width < maxWidth);
widths.push(maxWidth);
---

{source ? (
	<Image
		alt=""
		class="absolute inset-0 size-full object-cover"
		fetchpriority="high"
		format="webp"
		loading="eager"
		sizes="100vw"
		src={source}
		width={Math.min(1440, maxWidth)}
		widths={widths}
	/>
) : (
	<img
		alt=""
		class="absolute inset-0 size-full object-cover"
		fetchpriority="high"
		loading="eager"
		src={src}
	/>
)}
